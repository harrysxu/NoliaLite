{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for Nolia Lite document windows",
  "windows": ["main", "document-*"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "core:window:allow-start-dragging",
    "core:event:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "opener:default"
  ]
}
