{
  "name": "nolia-lite",
  "version": "0.1.0",
  "private": true,
  "description": "A lightweight, local-first Markdown editor",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:release": "node scripts/release-checks.mjs",
    "verify": "npm run typecheck && npm test && cargo test --manifest-path src-tauri/Cargo.toml && npm run build",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-opener": "2.5.4",
    "@tiptap/core": "3.29.0",
    "@tiptap/extension-code-block-lowlight": "^3.29.0",
    "@tiptap/extension-image": "3.29.0",
    "@tiptap/extension-link": "3.29.0",
    "@tiptap/extension-placeholder": "3.29.0",
    "@tiptap/extension-table": "3.29.0",
    "@tiptap/extension-task-item": "3.29.0",
    "@tiptap/extension-task-list": "3.29.0",
    "@tiptap/markdown": "3.29.0",
    "@tiptap/pm": "3.29.0",
    "@tiptap/react": "3.29.0",
    "@tiptap/starter-kit": "3.29.0",
    "dompurify": "^3.4.12",
    "katex": "^0.16.22",
    "lowlight": "^3.3.0",
    "lucide-react": "0.545.0",
    "marked": "^17.0.1",
    "mermaid": "^11.16.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "^25.5.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "jsdom": "27.4.0",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.0"
  }
}
